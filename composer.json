{
    "name": "crustum/mongo",
    "description": "Mongo plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": [
        "cakephp",
        "crustum",
        "mongo"
    ],
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.4",
        "cakephp/bake": "^3.7",
        "crustum/plugin-manifest": "^1.0",
        "mongodb/mongodb": "^2.0"
    },
    "require-dev": {
        "boundwize/structarmed": "^0.14",
        "cakedc/cakephp-phpstan": "^4.3",
        "cakephp/cakephp-codesniffer": "^5.0",
        "crustum/essentia": "^1.0",
        "mockery/mockery": "^1.6.12",
        "phpstan/phpstan": "^2.2.2,<2.2.6",
        "phpunit/phpunit": "^10.5 || ^11.1 || ^12.5",
        "rector/rector": "^2.5",
        "brianium/paratest": "^7.20"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\Mongo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crustum\\Mongo\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/TestApp/",
            "TestPlugin\\": "tests/test_app/Plugin/TestPlugin/src/",
            "TestPluginTwo\\": "tests/test_app/Plugin/TestPluginTwo/src/",
            "Company\\TestPluginThree\\": "tests/test_app/Plugin/Company/TestPluginThree/src/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "test:parallel": "paratest -p4",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse src/",
        "stan-baseline": "phpstan analyse --generate-baseline",
        "structarmed": "vendor/bin/structarmed analyze src"
    },
    "extra": {
        "installer-name": "Mongo"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
