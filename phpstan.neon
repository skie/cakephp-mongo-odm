includes:
    - vendor/cakedc/cakephp-phpstan/extension.neon

parameters:
    level: 7
    paths:
        - src
    bootstrapFiles:
        - tests/bootstrap.php
    cakeDC:
        appNamespace: Crustum\Mongo
    tmpDir: build/phpstan
    ignoreErrors:
        -
            identifier: new.static
            reportUnmatched: false
        -
            # Public library trait: unused within src/ by design (consumers mix it in).
            identifier: trait.unused
            path: src/TestSuite/MongoTestTrait.php
            reportUnmatched: false
        -
            # Public library trait: unused within src/ by design (consumers mix it in).
            identifier: trait.unused
            path: src/Database/TypeMapTrait.php
            reportUnmatched: false
        -
            # Public library trait: unused within src/ by design (consumers mix it in).
            identifier: trait.unused
            path: src/ODM/Enum/EnumLabelTrait.php
            reportUnmatched: false
        -
            # Public library trait: unused within src/ by design (consumers mix it in).
            identifier: trait.unused
            path: src/ODM/Locator/CollectionAwareTrait.php
            reportUnmatched: false

services:
