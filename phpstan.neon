includes:
    - vendor/cakedc/cakephp-phpstan/extension.neon

parameters:
    level: 7
    paths:
        - src
    bootstrapFiles:
        - tests/bootstrap.php
    cakeDC:
        appNamespace: Crustum\Mongo
    tmpDir: build/phpstan
    ignoreErrors:
        -
            identifier: new.static
            reportUnmatched: false
        -
            # Public library trait: unused within src/ by design (consumers mix it in).
            identifier: trait.unused
            path: src/TestSuite/MongoTestTrait.php
            reportUnmatched: false
        -
            # Public library trait: unused within src/ by design (consumers mix it in).
            identifier: trait.unused
            path: src/Database/TypeMapTrait.php
            reportUnmatched: false
        -
            # Public library trait: unused within src/ by design (consumers mix it in).
            identifier: trait.unused
            path: src/ODM/Enum/EnumLabelTrait.php
            reportUnmatched: false
        -
            # Public library trait: unused within src/ by design (consumers mix it in).
            identifier: trait.unused
            path: src/ODM/Locator/CollectionAwareTrait.php
            reportUnmatched: false
        -
            # Public library trait: unused within src/ by design (consumers mix it in).
            identifier: trait.unused
            path: src/Orm/Bridge/MongoAssociationsTrait.php
            reportUnmatched: false
        -
            # Public library trait: used by the Proxy classes in this package.
            identifier: trait.unused
            path: src/Orm/Bridge/Proxy/ProxyTrait.php
            reportUnmatched: false
        -
            # Public library trait: consumed by app tables outside src/.
            identifier: trait.unused
            path: src/Orm/Bridge/MongoCollectionAwareTrait.php
            reportUnmatched: false
        -
            # Public library trait: consumed by collections outside src/.
            identifier: trait.unused
            path: src/Orm/Bridge/OrmTableAwareTrait.php
            reportUnmatched: false
        -
            # Public library trait: consumed by collections outside src/.
            identifier: trait.unused
            path: src/Orm/Bridge/Orm/OrmAssociationsTrait.php
            reportUnmatched: false
        -
            # Public library trait: consumed by app collections that opt into
            # conventional Collection.* event callbacks (mirrors cake6
            # TableEventsTrait, which cake Table also does not mix in itself).
            identifier: trait.unused
            path: src/ODM/CollectionEventsTrait.php
            reportUnmatched: false

services:
