{#
/**
 * Crustum Mongo ODM — Document bake template.
 *
 * Ported from cakephp/bake `Model/entity.twig` for MongoDB.
 */
#}
{% set propertyHintMap = MongoDocBlock.buildEntityPropertyHintTypeMap(propertySchema ?: []) %}
{% set associationHintMap = MongoDocBlock.buildEntityAssociationHintTypeMap(propertySchema ?: []) %}
{% set annotations = MongoDocBlock.propertyHints(propertyHintMap) %}

{%- if associationHintMap -%}
    {%- set annotations = annotations|merge(['']) %}
    {%- set annotations = annotations|merge(MongoDocBlock.propertyHints(associationHintMap)) %}
{%- endif %}

{%- set accessible = Bake.getFieldAccessibility(fieldNames, primaryKey) %}

{%- set generatedProperties = [] %}
{%- set imports = ['Crustum\\Mongo\\ODM\\Document'] %}
{%- if fields is defined and fields|length > 0 -%}
    {%- set imports = imports|merge({'DocumentAttribute': 'Crustum\\Mongo\\ODM\\Attribute\\Document', 'Field': 'Crustum\\Mongo\\ODM\\Attribute\\Field'}) -%}
    {%- if useConstants -%}
        {%- set imports = imports|merge(['Crustum\\Mongo\\Database\\Schema\\CollectionSchemaInterface']) -%}
    {%- endif -%}
{%- endif -%}
{{- element('Bake.file_header', {
    namespace: fileBuilder.namespace,
    classImports: fileBuilder.classImports(imports),
}) }}

{{ MongoDocBlock.classDescription(name, 'Document', annotations)|raw }}
{% if fields is defined and fields|length > 0 %}
#[DocumentAttribute(collection: '{{ collection is defined ? collection : name|underscore }}')]
{% for field in fields %}
#[Field(name: '{{ field.name }}', type: {{ field.constant is not null ? 'CollectionSchemaInterface::' ~ field.constant : "'" ~ field.type ~ "'" }}{{ field.nullable ? ', nullable: true' : '' }}{{ field.primaryKey ? ', primaryKey: true' : '' }})]
{% endfor %}
{% endif %}
class {{ name }} extends Document{{ fileBuilder.classBuilder.implements ? ' implements ' ~ fileBuilder.classBuilder.implements|join(', ') : '' }}
{
{% set userConstants = fileBuilder.classBuilder.userConstants([]) %}
{% if userConstants %}
    {{~ Bake.concat('\n\n', userConstants) }}

{% endif %}
{% if accessible %}
{%~ set generatedProperties = generatedProperties|merge(['_accessible']) %}
    /**
     * Fields that can be mass assigned using newDocument() or patchDocument().
     *
     * Note that when '*' is set to true, this allows all unspecified fields to
     * be mass assigned. For security purposes, it is advised to set '*' to false
     * (or remove it), and explicitly make individual fields accessible as needed.
     *
     * @var array<string, bool>
     */
    protected array $_accessible = {{ Bake.exportVar(accessible, 1)|raw }};
{% endif %}
{% if accessible and hidden %}

{% endif %}
{% if hidden %}
    {%~ set generatedProperties = generatedProperties|merge(['_hidden']) %}
    /**
     * Fields that are excluded from JSON versions of the document.
     *
     * @var array<string>
     */
    protected array $_hidden = {{ Bake.exportVar(hidden, 1)|raw }};
{% endif %}
{% set userProperties = fileBuilder.classBuilder.userProperties(generatedProperties) %}
{% if userProperties %}

    {{~ Bake.concat('\n\n', userProperties) }}
{% endif %}
{% set userFunctions = fileBuilder.classBuilder.userFunctions([]) %}
{% if userFunctions %}

    {{~ Bake.concat('\n\n', userFunctions) }}
{% endif %}
}
